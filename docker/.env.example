# =============================================================================
#  Секреты KoFAuth. Скопируйте в .env и заполните.
#  Файл .env в git не попадает — он в .gitignore.
# =============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# ---- Обязательные ключи ----
# Сгенерировать:
#   openssl rand -base64 32   -> ENCRYPTION_KEY
#   openssl rand -hex 32      -> JWT_SECRET
#
# ВНИМАНИЕ: потеря ENCRYPTION_KEY делает нечитаемыми секреты TOTP и токены
# Discord. Храните его вместе с резервной копией базы — иначе восстановленный
# дамп окажется наполовину бесполезным.
ENCRYPTION_KEY=
JWT_SECRET=

# ---- Веб ----
WEBAPI_PORT=8080

# ---- Необязательное ----
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
