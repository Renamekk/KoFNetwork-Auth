# =============================================================================
#  KoFAuth — настройки развёртывания.
#
#  Этот файл — образец. Рабочий .env создаёт ./install.sh: он генерирует
#  секреты сам, руками их придумывать не нужно.
#  Копировать вручную имеет смысл только если хочется всё задать самому:
#      cp .env.example .env
#
#  .env содержит секреты и в git не попадает (см. .gitignore).
# =============================================================================

# ---------------------------------------------------------------- секреты
# Генерируются install.sh. Менять их у работающей сети нельзя:
#   ENCRYPTION_KEY  — потеря делает нечитаемыми секреты TOTP и токены Discord;
#   JWT_SECRET      — смена разлогинивает всех в личном кабинете;
#   FORWARDING_SECRET — должен совпадать у прокси и всех серверов Paper.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
RCON_PASSWORD=

# openssl rand -base64 32  (ровно 32 байта)
ENCRYPTION_KEY=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 24
FORWARDING_SECRET=

# ---------------------------------------------------------------- сеть
# Порт, на который заходят игроки.
MINECRAFT_PORT=25565
# 127.0.0.1 — сеть доступна только с этой машины (для проверки перед запуском).
# 0.0.0.0 — доступна извне.
MINECRAFT_BIND=0.0.0.0

# Куда переводить игрока после входа.
#   lobby:25565                    — лобби из этого же compose (профиль lobby)
#   host.docker.internal:25566     — игровой сервер, работающий вне Docker
# При своём сервере уберите lobby из COMPOSE_PROFILES ниже.
LOBBY_ADDRESS=lobby:25565

# База и кэш публикуются только на петлевой адрес. Менять на 0.0.0.0 не следует:
# открытый в интернет MySQL находят сканеры за часы.
MYSQL_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# Личный кабинет и REST API. При работе через Caddy (профиль web) поставьте
# WEBAPI_BIND=127.0.0.1 — тогда наружу смотрит только 443.
WEBAPI_PORT=8080
WEBAPI_BIND=0.0.0.0

# Домен для HTTPS. Заполняется, только если используется профиль web.
DOMAIN=
ACME_EMAIL=

# Доверять заголовку с реальным IP. Включать ТОЛЬКО когда перед WebAPI
# действительно стоит обратный прокси (Caddy, nginx, Cloudflare).
# Иначе клиент подставит любой адрес и обойдёт ограничения по IP.
TRUST_PROXY_HEADER=false

# Источники для CORS, если кабинет обслуживается с другого домена.
# Через запятую, например: https://kofnetwork.net,https://www.kofnetwork.net
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- игровая сеть
# Кавычки обязательны: без них всё после # docker compose считает комментарием.
# Поддерживается MiniMessage: <#d4af37>, <gradient:#5555FF:#AA00AA>, <bold>.
MOTD="<#d4af37>KoF Network"
MAX_PLAYERS=500
# Жёсткий лимит одного Limbo; маршрутизатор использует то же значение.
LIMBO_MAX_PLAYERS=50

# Версия Limbo и лобби. Обязана совпадать с версией клиента и остальных
# серверов сети: игрок 1.21.11 не зайдёт на Limbo 1.21.8.
PAPER_VERSION=1.21.8
# Номер сборки Paper. latest — последняя для указанной версии.
PAPER_BUILD=

LOBBY_GAMEMODE=survival
LOBBY_DIFFICULTY=normal
LOBBY_VIEW_DISTANCE=8
LOBBY_SIMULATION_DISTANCE=6

# ---------------------------------------------------------------- ресурсы
# Память ВНУТРИ JVM. Оставьте контейнеру запас сверху: JVM тратит память
# и вне кучи (метаданные классов, буферы сети, сжатые чанки).
HEAP_VELOCITY=512M
HEAP_LIMBO=768M
HEAP_LOBBY=2G

MYSQL_BUFFER_POOL=512M
MYSQL_MAX_CONNECTIONS=200
REDIS_MAXMEMORY=256mb

# Подробность логов: INFO, DEBUG, WARN. DEBUG включают на время разбора
# и снимают обратно — он пишет каждое обращение к базе.
LOG_LEVEL=INFO

# ---------------------------------------------------------------- профили
# Что поднимается по `docker compose up`.
#   lobby    — игровой сервер «из коробки» (уберите, если сервер уже свой)
#   telegram — бот Telegram
#   discord  — бот Discord
#   bots     — оба бота сразу
#   web      — HTTPS через Caddy
# Пример: COMPOSE_PROFILES=lobby,bots,web
COMPOSE_PROFILES=lobby

# ---------------------------------------------------------------- почта
# Без SMTP не работают: восстановление пароля, подтверждение адреса,
# уведомления о подозрительных входах. Всё остальное работает.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=KoF Network

# ---------------------------------------------------------------- Боты
# Ключ доступа ботов к /api/bot. Генерируется install.sh.
# Пустое значение выключает /api/bot целиком — боты перестанут работать.
BOT_API_KEY=
# Адрес личного кабинета: боты показывают его в справке.
PANEL_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------- Telegram
# Токен выдаёт @BotFather. Кто получил токен — может подтверждать входы
# от имени любого привязанного игрока.
TELEGRAM_BOT_TOKEN=
# Имя бота без собачки — подставляется в подсказку игроку в игре.
TELEGRAM_BOT_USERNAME=
# Включает команду /telegram на прокси. Без неё бот работает, но привязаться
# к нему игрок не может: код привязки выдаётся в игре.
TELEGRAM_ENABLED=false

# ---------------------------------------------------------------- Discord
DISCORD_BOT_TOKEN=
# ID сервера Discord: команды появляются мгновенно. Пусто — глобально, до часа.
DISCORD_GUILD_ID=
# Включает команду /discord на прокси — см. примечание к TELEGRAM_ENABLED.
DISCORD_ENABLED=false

# OAuth2 нужен только для привязки Discord с сайта. Привязка через бота
# работает и без него.
DISCORD_OAUTH_ENABLED=false
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
