# Адрес REST API KoFAuth. В docker-compose это имя сервиса.
KOFAUTH_API_URL=http://webapi:8080

# Ключ доступа к /api/bot. Тот же, что security.yml -> bot-api.key.
# Сгенерировать: openssl rand -hex 32
KOFAUTH_SECURITY_BOT_API_KEY=

# Канал событий KoFAuth.
KOFAUTH_REDIS_URL=redis://redis:6379/0
KOFAUTH_EVENT_CHANNEL=kofauth:events
KOFAUTH_EVENTS_ENABLED=true

# Адрес личного кабинета — показывается в справке ботов.
KOFAUTH_PANEL_URL=http://127.0.0.1:8080

# Telegram.
#
# BOT_USERNAME обязателен для ссылки t.me/бот?start=link_КОД, которую игра
# показывает вместо голого кода: по ней бот привязывает аккаунт сам. Без имени
# ссылки не будет — останется ручной ввод /link КОД.
KOFAUTH_TELEGRAM_BOT_TOKEN=
KOFAUTH_TELEGRAM_BOT_USERNAME=KoFNetworkAuthBot

# Discord. Пустой guild-id означает глобальную регистрацию команд (до часа).
KOFAUTH_DISCORD_BOT_TOKEN=
KOFAUTH_DISCORD_GUILD_ID=

# Канал привязки аккаунта. Игра показывает ссылку прямо на него, и туда же
# публикуется код, если включён discord.yml -> link.post-code-to-channel.
# ID канала: режим разработчика в Discord -> правой кнопкой -> «Копировать ID».
KOFAUTH_DISCORD_ACCOUNT_CHANNEL_ID=

# Оформление. Ни на что не влияет, кроме внешнего вида.
#
# BANNER_URL — картинка шапки в главном меню обоих ботов. Должна быть доступна
#   по HTTP: и Discord, и Telegram скачивают её своими серверами.
# BANNER_FILE — локальный файл вместо ссылки. Понимает только Telegram
#   (загружает один раз и дальше пользуется выданным file_id); Discord умеет
#   только ссылку, поэтому для него всё равно нужен BANNER_URL.
# DONATE_URL — страница поддержки сервера: кнопка в меню и строка в профиле.
#
# Оба BANNER_* — запасной путь. По умолчанию баннер и карточки берутся из
# ресурсов пакета, и настраивать для этого ничего не нужно.
KOFAUTH_BANNER_URL=
KOFAUTH_BANNER_FILE=
KOFAUTH_DONATE_URL=
KOFAUTH_SITE_URL=

# Графические экраны. Профиль, защита, история и сессии показываются картинкой
# с настоящими данными и родными кнопками под ней; главное меню и справка —
# заранее подготовленными картинками из ресурсов пакета.
#
# Всё это оформление и только оформление: при CARDS_ENABLED=false — и при любом
# сбое отрисовки — боты показывают те же экраны текстом, как показывали раньше.
# Подтверждение входа, предупреждения и ошибки остаются текстом всегда.
#
# CARDS_DIR — свой каталог ресурсов (fonts/ и screens/) вместо встроенного.
#   Пусто — берётся тот, что лежит внутри kofauth_common.
# CARDS_QUALITY — качество JPEG. 84 подобрано по весу: на тёмной панели
#   разницы с 90 не видно, а картинка легче почти на треть.
# CARDS_WORKERS — сколько карточек рисуется одновременно. Больше двух не нужно:
#   рисование должно уступать процессор подтверждению входа, а не спорить с ним.
# CARDS_CACHE_* — пределы кэша готовых картинок: по числу, по памяти и по
#   свежести. Кэш живёт в памяти процесса; файлов на пользователей не создаётся.
KOFAUTH_CARDS_ENABLED=true
KOFAUTH_CARDS_DIR=
KOFAUTH_CARDS_QUALITY=84
KOFAUTH_CARDS_WORKERS=2
KOFAUTH_CARDS_CACHE_ENTRIES=48
KOFAUTH_CARDS_CACHE_MB=24
KOFAUTH_CARDS_CACHE_TTL_SECONDS=600

# Фирменные emoji на кнопках. Список «ключ=значение» через запятую; ключи —
# из kofauth_common/glyphs.py (brand, profile, security, history, sessions,
# help, commands, link, unlink, logout, donate, approve, deny, bell_on,
# bell_off, back, ok, warning, lock, site).
#
# Пусто — показываются обычные значки, и это рабочий вид, а не заглушка.
# Идентификаторы выдают сами платформы: выдуманный номер даст пустой квадрат.
#
# DISCORD — «ключ=<:имя:id>» (или «ключ=имя:id»). Значение целиком копируется
#   из Discord: наберите \:имя: в чате и отправьте. Emoji должен быть доступен
#   боту: либо emoji приложения в Developer Portal, либо emoji сервера,
#   на котором бот состоит.
# TELEGRAM — «ключ=id» документа custom emoji, можно «ключ=id:символ», чтобы
#   задать свой запасной значок. Работает в тексте сообщений; надписи кнопок
#   Bot API сущностей не принимает, там всегда обычный символ. Право на
#   custom emoji есть не у каждого бота — при отказе бот сам переходит на
#   обычные значки.
#
# Любой платформе вместо идентификатора можно дать просто другой символ:
#   KOFAUTH_EMOJI_TELEGRAM=sessions=🧱,history=🧭
KOFAUTH_EMOJI_DISCORD=
KOFAUTH_EMOJI_TELEGRAM=

KOFAUTH_LOG_LEVEL=INFO
