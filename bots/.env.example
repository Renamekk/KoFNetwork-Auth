# Адрес REST API KoFAuth. В docker-compose это имя сервиса.
KOFAUTH_API_URL=http://webapi:8080

# Ключ доступа к /api/bot. Тот же, что security.yml -> bot-api.key.
# Сгенерировать: openssl rand -hex 32
KOFAUTH_SECURITY_BOT_API_KEY=

# Канал событий KoFAuth.
KOFAUTH_REDIS_URL=redis://redis:6379/0
KOFAUTH_EVENT_CHANNEL=kofauth:events
KOFAUTH_EVENTS_ENABLED=true

# Адрес личного кабинета — показывается в справке ботов.
KOFAUTH_PANEL_URL=http://127.0.0.1:8080

# Telegram.
#
# BOT_USERNAME обязателен для ссылки t.me/бот?start=link_КОД, которую игра
# показывает вместо голого кода: по ней бот привязывает аккаунт сам. Без имени
# ссылки не будет — останется ручной ввод /link КОД.
KOFAUTH_TELEGRAM_BOT_TOKEN=
KOFAUTH_TELEGRAM_BOT_USERNAME=KoFNetworkAuthBot

# Discord. Пустой guild-id означает глобальную регистрацию команд (до часа).
KOFAUTH_DISCORD_BOT_TOKEN=
KOFAUTH_DISCORD_GUILD_ID=

# Канал привязки аккаунта. Игра показывает ссылку прямо на него, и туда же
# публикуется код, если включён discord.yml -> link.post-code-to-channel.
# ID канала: режим разработчика в Discord -> правой кнопкой -> «Копировать ID».
KOFAUTH_DISCORD_ACCOUNT_CHANNEL_ID=

# Оформление. Ни на что не влияет, кроме внешнего вида.
#
# BANNER_URL — картинка шапки в главном меню обоих ботов. Должна быть доступна
#   по HTTP: и Discord, и Telegram скачивают её своими серверами.
# BANNER_FILE — локальный файл вместо ссылки. Понимает только Telegram
#   (загружает один раз и дальше пользуется выданным file_id); Discord умеет
#   только ссылку, поэтому для него всё равно нужен BANNER_URL.
# DONATE_URL — страница поддержки сервера: кнопка в меню и строка в профиле.
KOFAUTH_BANNER_URL=
KOFAUTH_BANNER_FILE=
KOFAUTH_DONATE_URL=
KOFAUTH_SITE_URL=

KOFAUTH_LOG_LEVEL=INFO
